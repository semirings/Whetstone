#!/bin/bash
# Usage:
#   ./run.sh BE [--clear-storage]   start the backend (FastAPI, port 8402)
#   ./run.sh FE                     start the Flutter macOS app
#   ./run.sh STOP                   stop the backend
#
# Ports: DoubleNaught 8400, SegForge 8401, Whetstone 8402.
# Override with WHETSTONE_PORT; FE follows it automatically.
# Cards are kept in storage/cards.parquet (storage/cards.tsv is a readable mirror).

set -e

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PORT="${WHETSTONE_PORT:-8402}"
PIDFILE="$ROOT/.wbe.pid"

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

case "$1" in

  STOP)
    if [ -f "$PIDFILE" ]; then
      PID=$(cat "$PIDFILE")
      if kill -0 "$PID" 2>/dev/null; then
        kill "$PID" && echo -e "${GREEN}Stopped Whetstone backend (pid $PID).${NC}"
      else
        echo -e "${YELLOW}PID $PID is not running.${NC}"
      fi
      rm -f "$PIDFILE"
    elif pkill -f "whetstone_be" 2>/dev/null; then
      echo -e "${GREEN}Stopped Whetstone backend (via pkill).${NC}"
    else
      echo -e "${YELLOW}Whetstone backend not running.${NC}"
    fi
    ;;

  BE)
    for arg in "$@"; do
      if [ "$arg" == "--clear-storage" ]; then
        echo -e "${YELLOW}Removing $ROOT/storage/cards.parquet and cards.tsv...${NC}"
        rm -f "$ROOT/storage/cards.parquet" "$ROOT/storage/cards.tsv"
      fi
    done
    echo -e "${BLUE}Starting backend on http://127.0.0.1:${PORT}${NC}"
    echo -e "${YELLOW}API docs: http://127.0.0.1:${PORT}/docs${NC}"
    cd "$ROOT"
    [ -d .venv ] || python3 -m venv .venv
    source .venv/bin/activate
    pip install -q -e "$ROOT/backend" 2>&1 | grep -v "already satisfied" || true
    echo $$ > "$PIDFILE"
    export WHETSTONE_PORT="$PORT" WHETSTONE_RELOAD=1
    exec python -m whetstone_be
    ;;

  FE)
    cd "$ROOT"
    flutter pub get
    flutter run -d macos --dart-define=WHETSTONE_BACKEND_URL="http://127.0.0.1:${PORT}"
    ;;

  *)
    echo "Usage: ./run.sh BE [--clear-storage] | FE | STOP"
    exit 1
    ;;
esac
